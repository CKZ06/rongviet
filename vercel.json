{
  "version": 2,
  "outputDirectory": "dino4vn.com",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/status.json",
      "destination": "/api/status"
    },
    {
      "source": "/api/bang-xep-hang.json",
      "destination": "/api/bxh"
    },
    {
      "source": "/api/player/me",
      "destination": "/api/player/me"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
