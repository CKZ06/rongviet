{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "dino4vn.com",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dang-nhap",
      "destination": "/api/auth/steam"
    },
    {
      "source": "/api/auth/steam",
      "destination": "/api/auth/steam"
    },
    {
      "source": "/api/auth/steam/return",
      "destination": "/api/auth/return"
    },
    {
      "source": "/api/status.json",
      "destination": "/api/status"
    },
    {
      "source": "/api/bang-xep-hang.json",
      "destination": "/api/bxh"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
